  "test": {
    "subject": "رسالة اختبار البريد — Ticket Arab",
    "html": "<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:24px 12px;background:#f3f5f7;font-family:Tahoma,Arial,sans-serif;color:#17212b\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:620px;background:#fff;border:1px solid #e4e8ed;border-radius:16px;overflow:hidden\"><tr><td style=\"padding:24px 30px;background:#101b29;border-bottom:4px solid #d6ad5b;color:#fff\"><div style=\"font-size:21px;font-weight:800\">TICKET <span style=\"color:#e4bd70\">ARAB</span></div><div style=\"margin-top:6px;color:#c7d0da;font-size:13px\">حجزك يبدأ من هنا</div></td></tr><tr><td style=\"padding:32px 30px;text-align:right;line-height:1.9\"><div style=\"color:#a57926;font-size:12px;font-weight:700\">رسالة تجريبية</div><h1 style=\"margin:8px 0 12px;font-size:24px\">مرحبًا بك في Ticket Arab</h1><p style=\"margin:0 0 18px;color:#52606d;font-size:15px\">تم إرسال هذه الرسالة للتأكد من إعداد البريد الإلكتروني في موقع Ticket Arab.</p><div style=\"padding:14px 16px;border:1px solid #e4e8ed;border-radius:10px;background:#f8fafb;color:#52606d;font-size:13px\">إذا وصلت هذه الرسالة إلى بريدك، فهذا يعني أن مزود البريد قبلها للإرسال. تحقق أيضًا من مجلد الرسائل غير المرغوب فيها.</div></td></tr><tr><td style=\"padding:18px 30px;background:#f8fafb;border-top:1px solid #e4e8ed;color:#7a8794;font-size:11px;line-height:1.8;text-align:center\">رسالة آلية من Ticket Arab. لا ترد على هذا البريد إن لم تطلب الاختبار.<br>© Ticket Arab</td></tr></table></td></tr></table></body></html>"
  },
  "ticket": {
    "subject": "تذاكرك جاهزة {{orderNumber}} — Ticket Arab",
    "html": "<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:24px 12px;background:#f3f5f7;font-family:Tahoma,Arial,sans-serif;color:#17212b\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td align=\"center\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:620px;background:#fff;border:1px solid #e4e8ed;border-radius:16px;overflow:hidden\"><tr><td style=\"padding:24px 30px;background:#101b29;border-bottom:4px solid #d6ad5b;color:#fff\"><div style=\"font-size:21px;font-weight:800\">TICKET <span style=\"color:#e4bd70\">ARAB</span></div><div style=\"margin-top:6px;color:#c7d0da;font-size:13px\">تذاكرك جاهزة</div></td></tr><tr><td style=\"padding:30px;text-align:right;line-height:1.9\"><div style=\"margin-bottom:10px;color:#24825d;font-size:12px;font-weight:700\">تم تجهيز التذاكر</div><h1 style=\"margin:0 0 12px;font-size:23px\">أهلًا {{buyerName}}</h1><p style=\"margin:0 0 18px;color:#52606d;font-size:14px\">شكرًا لاختيارك Ticket Arab. تجد تفاصيل حجزك والرسالة والمرفقات التي أضفتها أدناه.</p><div style=\"margin-bottom:20px;padding:12px 15px;border-radius:10px;background:#f8fafb;color:#52606d;font-size:12px\">رقم المعاملة: <b dir=\"ltr\" style=\"color:#17212b\">{{orderNumber}}</b></div><div style=\"padding:0 0 14px;color:#17212b\">{{{message}}}</div><h2 style=\"margin:22px 0 10px;padding-bottom:8px;border-bottom:1px solid #e5e9ee;font-size:16px\">تفاصيل التذاكر</h2><div style=\"color:#52606d;font-size:13px;line-height:1.9\">{{{ticketList}}}</div></td></tr><tr><td style=\"padding:18px 30px;background:#f8fafb;border-top:1px solid #e5e9ee;color:#7a8794;font-size:11px;line-height:1.8;text-align:center\">نتمنى لك وقتًا ممتعًا. للدعم، تواصل معنا عبر صفحة الدعم.<br>© Ticket Arab</td></tr></table></td></tr></table></body></html>"
  },
  "invoice": {
