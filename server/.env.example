NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-a-different-random-value-of-at-least-32-bytes
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=

# PayPal developer app credentials. Use sandbox until live payments are configured.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=


# Paymegate hosted checkout. Keep secrets server-side and configure this signed
# webhook URL in the merchant dashboard; the signing secret is encrypted in Neon.
PAYMEGATE_API_KEY=
PAYMEGATE_WEBHOOK_SECRET=

# Select brevo, smtp2go, resend, or smtp in admin email settings.
BREVO_API_KEY=
SMTP2GO_API_KEY=
RESEND_API_KEY=
## API credentials may be configured here or saved encrypted from admin settings.

# Generic SMTP settings for any provider (server name is optional).
SMTP_PROVIDER_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# auto, starttls, or tls. Prefer auto unless your provider specifies otherwise.
SMTP_TLS_MODE=auto
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL=

# Heleket crypto checkout; credentials can also be saved encrypted in admin settings
HELEKET_MERCHANT_ID=
HELEKET_PAYMENT_API_KEY=

